# ==============================================================================
# Shape-Shift Racer by Sarthak - Environment Configuration Template
# ==============================================================================

# Feature Flags for Google AdSense
# Set to 'true' to activate ad containers (strictly hidden by default).
VITE_ADS_ENABLED=true
VITE_SHOW_ADS=true

# Google AdSense Publisher ID
# Format: ca-pub-XXXXXXXXXXXXXXXX (minimum 10 digits after ca-pub-)
VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456

# Google AdSense Ad Slot IDs (Created in your AdSense console -> By ad unit)
# 1. Menu Leaderboard (728x90) - Displayed only on Start / Main Menu screen
VITE_ADSENSE_SLOT_MENU=1000000001

# 2. Game Over Rectangle (300x250) - Displayed only on Game Over screen
VITE_ADSENSE_SLOT_GAMEOVER=1000000002

# 3. Below Game Canvas (728x90 Horizontal) - Sits between canvas and game guide
VITE_ADSENSE_SLOT_BELOW_GAME=1000000003

# 4. Editorial Content Mid-Article (Responsive Auto)
VITE_ADSENSE_SLOT_EDITORIAL_MID=1000000004

# Test Mode: Adds data-adtest="on" so Google AdSense serves test ads and never
# flags development/staging traffic. Set to false for live production launch.
VITE_ADSENSE_TEST_MODE=true
