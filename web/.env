# Feature Flags for Google AdSense
# Ads are kept disabled (false) during Google AdSense site review.
# The official verification script tag and ads.txt remain permanently active.
# Once AdSense approves the domain, switch these to 'true' to display live ads.
VITE_ADS_ENABLED=false
VITE_SHOW_ADS=false

# Google AdSense Publisher ID
VITE_ADSENSE_CLIENT_ID=ca-pub-4627783195003112

# Google AdSense Ad Slot IDs (Created in AdSense console)
VITE_ADSENSE_SLOT_MENU=7772868480
VITE_ADSENSE_SLOT_GAMEOVER=7772868480
VITE_ADSENSE_SLOT_BELOW_GAME=7772868480
VITE_ADSENSE_SLOT_EDITORIAL_MID=7772868480

# Test Mode: Set to false for production
VITE_ADSENSE_TEST_MODE=false
